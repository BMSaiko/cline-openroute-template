# OpenRoute API Configuration
OPENROUTE_API_KEY=your_api_key_here
OPENROUTE_BASE_URL=https://api.openrouteservice.org/v2

# Rate Limiting (ajustar conforme a tua conta)
MAX_PER_MINUTE=20
MAX_PER_DAY=50
MAX_CONCURRENCY=3

# Compression
COMPRESSION_METHOD=mlm        # nlp, mlm, ou llm
ENABLE_COMPRESSION=true

# Cache
CACHE_TTL_ROUTES=300          # 5 minutos
CACHE_TTL_GEOCODE=86400       # 24 horas

# Retry
MAX_RETRIES=5